# Firebase Project Configuration (from Firebase Console -> Project Settings -> Web App)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Firebase App Check Debug Token (optional: leave blank to auto-generate one in DevTools console,
# or paste a pre-registered UUID from Firebase Console -> App Check -> Apps -> Manage debug tokens)
VITE_APPCHECK_DEBUG_TOKEN=
